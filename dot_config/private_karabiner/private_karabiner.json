{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "cmd-shift-m: toggle SketchyBar / macOS menu bar (was aerospace's cmd-shift-m binding)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "m",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin /Users/mince/.config/sketchybar/plugins/toggle_bar.sh > /tmp/toggle_bar.log 2>&1" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Herdr: C-j を macSKK に届ける（かなキーに変換）",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": ["^dev\\.herdr\\.app$"],
                                        "type": "frontmost_application_if"
                                    },
                                    {
                                        "input_sources": [{ "input_source_id": "^net\\.mtgto\\.inputmethod\\.macSKK" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "j",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "japanese_kana" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 12870,
                        "vendor_id": 6645
                    },
                    "ignore": false
                },
                {
                    "identifiers": {
                        "device_address": "c6-0f-3b-94-8e-4d",
                        "is_keyboard": true,
                        "is_pointing_device": true
                    },
                    "ignore": false
                }
            ],
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "left_control" }]
                },
                {
                    "from": { "key_code": "right_shift" },
                    "to": [{ "key_code": "grave_accent_and_tilde" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}