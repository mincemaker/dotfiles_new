# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# sketchybar --bar position=top height=40 blur_radius=30 color=0x40000000 display=all
bar=(
  height=40
  color=0x40000000
  shadow=on
  position=top
  sticky=on
  padding_left=8
  padding_right=8
  margin=8
  corner_radius=12
  blur_radius=0
  notch_width=200
  display=all
)
sketchybar --bar "${bar[@]}"

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="PlemolJP Console NF:Regular:17.0"
  label.font="x14y24pxHeadUpDaisy:Regular:16.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding AeroSpace Workspace Indicators #####

sketchybar --add event aerospace_workspace_change

SPACE_ICONS=("1" "2" "3" "4" "A" "S" "D" "F")
for sid in "${SPACE_ICONS[@]}"
do
  space=(
    label="$sid"
    icon.drawing=off
    label.font="x14y24pxHeadUpDaisy:Regular:16.0"
    #label.font="Moralerspace Krypton HW:Regular:16.0"
    padding_left=2
    padding_right=2
    background.color=0x44ffffff
    background.corner_radius=6
    background.height=26
    background.drawing=off
    script="$PLUGIN_DIR/space.sh $sid"
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space."$sid" left \
             --subscribe space."$sid" aerospace_workspace_change \
             --set space."$sid" "${space[@]}"
done

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding the Now Playing Item #####
# The built-in media_change event is dead since macOS 15.4 locked MediaRemote,
# so this item is driven by plugins/media_listener.sh instead.
#
# Everything below needs media-control, which is not part of a stock macOS. Say
# so in the bar rather than leaving an item that silently never appears — this
# is the one dependency the config cannot satisfy on its own.

if command -v media-control > /dev/null 2>&1; then
  HAS_MEDIA_CONTROL=1
else
  HAS_MEDIA_CONTROL=0
fi

if [ "$HAS_MEDIA_CONTROL" -eq 0 ]; then
  # Clicking copies the install command, so it can go straight into a terminal.
  sketchybar --add item media left \
             --set media icon=󰏔 \
                         icon.color=0xffffcc66 \
                         label="brew install media-control" \
                         label.color=0xffffcc66 \
                         click_script="printf 'brew install media-control' | pbcopy"
else
  sketchybar --add event media_change_custom

  sketchybar --add item media left \
             --set media script="$PLUGIN_DIR/media.sh" \
                         label.max_chars=35 \
                         drawing=off \
                         click_script="media-control toggle-play-pause" \
                         popup.background.color=0xcc1e1e2e \
                         popup.background.corner_radius=8 \
                         popup.background.border_width=1 \
                         popup.background.border_color=0x44ffffff \
                         popup.background.shadow.drawing=on \
                         popup.align=left \
                         popup.y_offset=2 \
                         popup.height=26 \
             --subscribe media media_change_custom mouse.entered mouse.exited mouse.exited.global

  # Popup contents, drawn top to bottom in this order. Each row runs media.sh on
  # hover purely so that being inside the popup cancels the pending close — see
  # the mouse handling at the top of that script.
  sketchybar --add item media.artwork popup.media \
             --set media.artwork icon.drawing=off label.drawing=off \
                                 background.drawing=on \
                                 background.image.drawing=off \
                                 background.image.scale=1.0 \
                                 script="$PLUGIN_DIR/media.sh" \
             --subscribe media.artwork mouse.entered mouse.exited \
             --add item media.title popup.media \
             --set media.title label.max_chars=28 \
                               script="$PLUGIN_DIR/media.sh" \
             --subscribe media.title mouse.entered mouse.exited \
             --add item media.artist popup.media \
             --set media.artist icon.drawing=off label.max_chars=28 \
                                label.color=0xccffffff \
                                script="$PLUGIN_DIR/media.sh" \
             --subscribe media.artist mouse.entered mouse.exited \
             --add item media.album popup.media \
             --set media.album icon.drawing=off label.max_chars=28 \
                               label.color=0x88ffffff \
                               script="$PLUGIN_DIR/media.sh" \
             --subscribe media.album mouse.entered mouse.exited
fi

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --add item ram right \
           --set ram update_freq=2 icon= script="$PLUGIN_DIR/ram.sh" \
           --add item cpu right \
           --set cpu update_freq=2 icon= script="$PLUGIN_DIR/cpu.sh" \
           --add item wifi right \
           --set wifi icon= script="$PLUGIN_DIR/wifi.sh" label.drawing=off \
           --subscribe wifi wifi_change \
           --subscribe battery system_woke power_source_change \
           --add item network right \
           --set network update_freq=2 icon.drawing=off script="$PLUGIN_DIR/network.sh"

##### Start the now playing listeners in the background #####
# Two separate streams: artwork arrives on its own event, well after the title,
# so it needs a listener that keeps watching rather than a one-shot fetch.
if [ "$HAS_MEDIA_CONTROL" -eq 1 ]; then
  "$PLUGIN_DIR/media_listener.sh" > /dev/null 2>&1 &
  "$PLUGIN_DIR/media_artwork_listener.sh" > /dev/null 2>&1 &
fi

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
